# 默认使用 SQLite：data/market.db（存在时）或 data/market.db.gz（启动时自动解压）
# 需要连接 MySQL 时，复制本文件为 .env 并填写以下配置

DB_HOST=localhost
DB_PORT=3306
DB_NAME=a_share_research
DB_USER=your_user
DB_PASSWORD=your_password

# 完整连接串，优先级高于上面的分项配置
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/a_share_research?charset=utf8mb4

# 强制指定后端：sqlite 或 mysql。留空时按上面的配置自动判断
# DB_BACKEND=sqlite

# 自定义 SQLite 文件路径，相对路径基于项目根目录
# SQLITE_PATH=data/market.db
